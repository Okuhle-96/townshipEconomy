NODE_ENV=development
PORT=3000
# Replace the placeholder username and password with local PostgreSQL credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/township_db
# Use the local origin for development; set the exact HTTPS origin when deployed.
APP_ORIGIN=http://localhost:3000
# For managed PostgreSQL that requires TLS, set PGSSL=true and install its trusted CA.
PGSSL=false
# Set COOKIE_SECURE=true when serving through HTTPS.
COOKIE_SECURE=false
# Generate a random secret of at least 32 characters for production.
SESSION_SECRET=replace-with-a-private-random-secret-at-least-32-characters
# Optional until password resets are enabled; create a Resend API key and verify the sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
